# HelpeRP — .gitignore

# Пользовательские данные (не коммитить!)
settings.json
.helperp_dev

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.spec.bak
*.spec

# Сборки и виртуальное окружение
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Логи и временные файлы
*.log
*.tmp
